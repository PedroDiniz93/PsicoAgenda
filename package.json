{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "e2e:prepare": "APP_ENV=testing DB_CONNECTION=sqlite DB_DATABASE=database/e2e.sqlite php artisan migrate:fresh --force && APP_ENV=testing DB_CONNECTION=sqlite DB_DATABASE=database/e2e.sqlite php artisan db:seed --class=Database\\\\Seeders\\\\E2ESeeder --force",
        "e2e": "npm run e2e:prepare && playwright test",
        "e2e:ui": "npm run e2e:prepare && playwright test --ui"
    },
    "dependencies": {
        "@lucide/vue": "^1.17.0",
        "axios": "^1.20.0",
        "laravel-echo": "^2.5.0",
        "node": "^24.12.0",
        "pinia": "^2.2.6",
        "pusher-js": "^8.6.0",
        "vue": "^3.5.12",
        "vue-router": "^4.4.3"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "concurrently": "^9.2.4",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.3.6"
    }
}
